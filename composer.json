{
    "name": "raxos/http",
    "description": "Http client and foundation.",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "type": "library",
    "authors": [
        {
            "name": "Bas Milius",
            "email": "bas@mili.us"
        }
    ],
    "autoload": {
        "psr-4": {
            "Raxos\\Http\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "symlink": true
        }
    ],
    "require": {
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7",
        "jetbrains/phpstorm-attributes": "^1.2",
        "php": ">=8.5",
        "psr/http-client": "^1",
        "psr/http-factory": "^1",
        "psr/http-message": "^1 || ^2",
        "raxos/collection": "^3.2",
        "raxos/contract": "^3.2",
        "raxos/datetime": "^3.2",
        "raxos/error": "^3.2",
        "raxos/foundation": "^3.2"
    },
    "require-dev": {
        "raxos/database": "^3.2",
        "pestphp/pest": "^5.0"
    },
    "suggest": {
        "raxos/database": "to use the Model constraint attribute."
    },
    "autoload-dev": {
        "classmap": [
            "tests/Fixtures/"
        ]
    },
    "scripts": {
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.3.x-dev"
        }
    }
}
